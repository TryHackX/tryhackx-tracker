# Generated by installer — never commit these
config/database.php
config/hash.txt
config/installed.lock

# Runtime state written under config/ (never commit — may contain IPs / cached data)
config/stats_cache.json
config/stats_fetch.lock
config/login_attempts.json
config/rate_limits.json
config/blacklist_changes.json
config/whitelist_state.json
config/whitelist_state.json.tmp.*
config/whitelist_state.lock
config/whitelist_regen.lock
config/stats_timeline_state.json
config/stats_timeline_state.json.tmp.*
config/stats_timeline_state.lock
config/stats_timeline_*.json
config/stats_timeline_*.json.tmp.*
config/stats_timeline_*.json.lock
config/index_state.json
config/index_state.json.tmp.*
config/index_state.lock
config/index_poll.lock
config/index_prune.lock
config/users_state.json
config/net_state.json
config/net_state.json.tmp.*
config/net_state.lock
config/backup_state.json
config/backup_state.json.tmp.*
config/backup_state.lock
config/*.marker

# Stray backups — must never ship to production (e.g. hash.txt.orig leaks the admin hash)
*.orig
*.bak

# Local deploy secrets / worker config copies
worker/tracker-metadata.conf

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode (worker)
__pycache__/
*.pyc

# Local working notes / tooling — never part of the release
.claude/
*.log
HANDOFF*.md
SPEC-*.md
