RewriteEngine On

# Set this to the URL path the app is served from.
#   domain root  -> RewriteBase /
#   subfolder    -> RewriteBase /tracker/   (matches this folder name under www/)
RewriteBase /tracker/

# Block access to hidden files (except .htaccess itself)
<FilesMatch "^\.(?!htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to sensitive file extensions
<FilesMatch "\.(sql|log|bak|old|ini|sh|env|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Content-Security-Policy. 'unsafe-inline'/'unsafe-eval' are needed by the inline
    # scripts / onclick handlers and the CAPTCHA widgets. Remote hosts allowed: jsDelivr
    # (Bootstrap + icons) and one host set per CAPTCHA provider — Google/Gstatic/reCAPTCHA.net
    # (reCAPTCHA v2 + v3), challenges.cloudflare.com (Turnstile) and hcaptcha.com (hCaptcha).
    # Keep this list in sync with captchaProviders() / captchaHeadTags() in includes/functions.php:
    # a provider missing here loads no script, so its widget never appears and every protected form
    # fails with "CAPTCHA unavailable". The apex hcaptcha.com is listed next to the wildcard because
    # a CSP wildcard does not match the bare domain. Tighten if you self-host these.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com https://js.hcaptcha.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://hcaptcha.com https://*.hcaptcha.com; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: https://www.google.com https://www.gstatic.com https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://cdn.jsdelivr.net https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Prevent directory listings
Options -Indexes

# Pass the Authorization header to PHP (php-fpm / CGI drop it otherwise) — needed by the bearer S2S API
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Serve static assets directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API requests
RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

# Route everything else to index.php
RewriteRule ^(.*)$ index.php?action=$1 [QSA,L]
