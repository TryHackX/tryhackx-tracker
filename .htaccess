RewriteEngine On

# Set this to the URL path the app is served from.
#   domain root  -> RewriteBase /
#   subfolder    -> RewriteBase /tracker/   (matches this folder name under www/)
RewriteBase /tracker/

# Block access to hidden files (except .htaccess itself)
<FilesMatch "^\.(?!htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to sensitive file extensions
<FilesMatch "\.(sql|log|bak|old|ini|sh|env|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Content-Security-Policy — THE FALLBACK, not the policy this application sends.
    #
    # Since 1.38.0 the real policy is built per request in includes/csp.php and sent by PHP, because
    # that is the only place a per-request NONCE can be minted. Settings → Security →
    # Content-Security-Policy is where it is switched between report-only, enforce and off.
    #
    # THIS FILE IS READ. An earlier version of this comment said production was nginx and that this
    # file did nothing; it is Apache 2.4.68 with mod_headers and AllowOverride All, measured on the
    # host on 2026-09-08 (`Server: Apache/2.4.68 (Debian)`, apache2 owning :443, nginx inactive) —
    # and the fallback header below was visible on the live response. Everything the rest of this
    # block reasons about therefore APPLIES here rather than being theory for somebody else.
    #
    # `setifempty`, NOT `set`, and the difference is the whole point (Apache 2.4.7+, 2013 — every
    # Apache that can run PHP 8.5 has it): `Header set` REPLACES a header PHP already sent, so this
    # line would have quietly overwritten the nonce policy with this permissive one and the feature
    # would have been decorative on Apache. With `setifempty` PHP's header wins whenever PHP sends
    # one, and this line only fills in when it does not — csp_mode='off'.
    #
    # In REPORT-ONLY mode PHP sends a DIFFERENT header name (Content-Security-Policy-Report-Only),
    # so both are present and each does its own job: this one keeps enforcing exactly what it always
    # enforced, and the new one only reports. That is deliberate — an Apache install loses no
    # protection during the report-only phase. Two ENFORCING policies would be intersected by the
    # browser (the strictest of each directive wins), which is why the modes never overlap.
    #
    # 'unsafe-inline'/'unsafe-eval' are needed by the inline
    # scripts / onclick handlers and the CAPTCHA widgets. Remote hosts allowed: jsDelivr
    # (Bootstrap + icons) and one host set per CAPTCHA provider — Google/Gstatic/reCAPTCHA.net
    # (reCAPTCHA v2 + v3), challenges.cloudflare.com (Turnstile) and hcaptcha.com (hCaptcha).
    # Keep this list in sync with captchaProviders() / captchaHeadTags() in includes/functions.php:
    # a provider missing here loads no script, so its widget never appears and every protected form
    # fails with "CAPTCHA unavailable". The apex hcaptcha.com is listed next to the wildcard because
    # a CSP wildcard does not match the bare domain. Tighten if you self-host these.
    #
    # img-src carries `https:` so that IMAGES IN DESCRIPTIONS WORK. Without it the renderer emits a
    # perfectly good <img> and the browser refuses to load it, which looks exactly like a broken
    # feature and was reported as one: the setting said "up to 3 images" and the policy said none.
    # The cost is real and worth stating: an author can embed a remote image, and whoever hosts it
    # then sees the IP and user agent of everybody who reads that description. The renderer sets
    # referrerpolicy="no-referrer" so the page they were on does not travel with it, and the image
    # limit is per description. If you would rather not pay that at all, delete `https:` from
    # img-src below and set "Images per description" to 0 in Settings, so the panel stops offering
    # something the server forbids.
    Header setifempty Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com https://js.hcaptcha.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://hcaptcha.com https://*.hcaptcha.com; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: https: https://www.google.com https://www.gstatic.com https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://cdn.jsdelivr.net https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Prevent directory listings
Options -Indexes

# Pass the Authorization header to PHP (php-fpm / CGI drop it otherwise) — needed by the bearer S2S API
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Serve static assets directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API requests
RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

# Route everything else to index.php
RewriteRule ^(.*)$ index.php?action=$1 [QSA,L]
