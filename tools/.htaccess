# Deny all direct access to tools (1.75.3)
# Everything here runs from the command line, the janitor timer or a root helper — nothing in the
# templates, assets or API links to it. Before this file the .php CLIs refused a web request on their
# own (PHP_SAPI), but the .py, .patch and .md files were fetchable, among them the internal
# tools/opentracker/UPSTREAM-REPORT.md, and the vhost's RedirectMatch does not cover tools/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
