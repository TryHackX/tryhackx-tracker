# ── torrent-count-race ─────────────────────────────────────────────────────────────
--- opentracker/ot_mutex.c
+++ opentracker/ot_mutex.c
@@ -41,14 +41,18 @@
 
 void mutex_bucket_unlock(int bucket, int delta_torrentcount) {
   pthread_mutex_unlock(bucket_mutex + bucket);
-  g_torrent_count += delta_torrentcount;
+  /* Updated outside the bucket lock by every worker, the main thread and the
+     clean thread: a plain += loses concurrent updates and the drift is permanent.
+     Relaxed atomic add; skipped when delta is 0 (almost every unlock). */
+  if (delta_torrentcount)
+    __atomic_add_fetch(&g_torrent_count, delta_torrentcount, __ATOMIC_RELAXED);
 }
 
 void mutex_bucket_unlock_by_hash(ot_hash const hash, int delta_torrentcount) {
   mutex_bucket_unlock(uint32_read_big((char *)hash) >> OT_BUCKET_COUNT_SHIFT, delta_torrentcount);
 }
 
-size_t mutex_get_torrent_count(void) { return g_torrent_count; }
+size_t mutex_get_torrent_count(void) { return __atomic_load_n(&g_torrent_count, __ATOMIC_RELAXED); }
 
