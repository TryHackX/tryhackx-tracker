# ── accesslist-uaf ─────────────────────────────────────────────────────────────
--- opentracker/ot_accesslist.c
+++ opentracker/ot_accesslist.c
@@ -90,10 +90,14 @@
 }
 
 /* This must be called with g_accesslist_mutex held.
-   This will never delete head, because that might still be in use. */
+   This will never delete head, because that might still be in use.
+   A node's base is the minute it was created, i.e. the minute it superseded its ->next.
+   So free a node only once its predecessor in the chain is more than five minutes old:
+   this keeps the list that was head until a moment ago alive whatever its own age and
+   prevents free()ing (munmap of a 32 MB whitelist) under a reader still in bsearch. */
 static void accesslist_clean(ot_accesslist *accesslist) {
   while (accesslist && accesslist->next) {
-    if (accesslist->next->base + 5 < g_now_minutes)
+    if (accesslist->base + 5 < g_now_minutes)
       accesslist->next = accesslist_free(accesslist->next);
     accesslist = accesslist->next;
   }

