@@ -28,22 +32,48 @@
 static volatile uint32_t g_key_of_the_hour[2] = {0};
 static volatile ot_time  g_hour_of_the_key;
 
+#ifndef WANT_ARC4RANDOM
+/* Take the connection id secrets from the kernel instead of random().
+   Without WANT_ARC4RANDOM/WANT_DEV_RANDOM random() is seeded with
+   srandom(time(NULL)), so every AES key and key of the hour would be a
+   function of the start second and connids could be forged for any ip. */
+static void udp_fill_random(void *buf, size_t len) {
+  uint8_t *p = buf;
+  while (len) {
+    ssize_t n = getrandom(p, len, 0);
+    if (n < 0) {
+      if (errno == EINTR)
+        continue;
+      /* No getrandom in this kernel: keep the old behaviour */
+      while (len--)
+        *p++ = (uint8_t)random();
+      return;
+    }
+    p += n;
+    len -= n;
+  }
+}
+
+static uint32_t udp_random_u32(void) {
+  uint32_t r;
+  udp_fill_random(&r, sizeof(r));
+  return r;
+}
+#endif
+
