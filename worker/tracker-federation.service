[Unit]
Description=Tracker federation importer (pulls index metadata from peers)
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=tracker
Group=tracker
ExecStart=/usr/bin/python3 /home/tracker/metadata_worker/federation.py /etc/tracker-metadata.conf
Nice=10
# hardening — the importer parses JSON from remote peers
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
